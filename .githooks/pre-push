#!/bin/sh
# Prüft neue Commits vor dem Hochladen auf Zugangsdaten.
# Einmalig aktivieren: git config core.hooksPath .githooks
[ -n "$CI" ] && exit 0
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[gitleaks] Hochladen blockiert: gitleaks fehlt auf diesem Rechner." >&2
  echo "           https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

status=0
while read -r _lokal_ref lokal_sha _fern_ref _fern_sha; do
  [ -n "$lokal_sha" ] || continue
  case "$lokal_sha" in *[!0]*) ;; *) continue ;; esac
  gitleaks git --log-opts="$lokal_sha --not --remotes" \
    --redact --verbose --no-banner --log-level warn --exit-code 1 . >&2 || status=1
done
exit "$status"
